# =============================================================================
# StockPawn 환경변수 템플릿 — cp .env.example .env 후 값 채우기 (.env는 커밋 금지)
# 실행: uvicorn app.main:app --env-file .env
# =============================================================================

# 연 이자율. 기본 0.20(법정 최고금리). 0.20 초과 값이면 import 시점에 ValueError로
# 앱이 뜨지 않는다 — 낮추는 방향으로만 의미가 있다.
# ANNUAL_RATE=0.20

# DB. MVP는 SQLite 단일 파일 (data/는 gitignore 대상)
DATABASE_URL=sqlite:///./data/stockpawn.db

# 시세 소스: pykrx(기본) | kis(stub — 미구현)
PRICE_SOURCE=pykrx

# pykrx >= 1.2는 KRX 정보데이터시스템 로그인이 있어야 시가총액·거래대금·거래일 조회가 된다.
# (https://data.krx.co.kr 회원가입) 없으면 시가총액 미상 → 최고 C등급으로만 평가된다.
KRX_ID=
KRX_PW=

# 브로커: mock(기본, 전일 종가 체결 시뮬레이션) | kis(stub)
# 실제 증권사 주문은 대부업 등록·증권사 제휴 전까지 금지. kis를 쓰려면 아래 플래그도 필요.
BROKER=mock
ENABLE_LIVE_ORDERS=false

# 내장 스케줄러 (00:05 이자 적립, 장중 10분 평가, 08:45 처분 주문, 15:40 장후 평가)
SCHEDULER_ENABLED=true

# 라이브러리 릴리스 이후 지정된 임시공휴일 등 (쉼표 구분 YYYY-MM-DD)
EXTRA_HOLIDAYS=
